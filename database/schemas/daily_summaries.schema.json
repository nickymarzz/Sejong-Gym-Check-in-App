{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["gymId", "date", "totalVisits", "uniqueStudents", "peakOccupancy", "averageDurationMinutes"],
    "properties": {
      "gymId": {
        "bsonType": "string",
        "description": "Gym facility identifier reference"
      },
      "date": {
        "bsonType": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "description": "Date formatted as YYYY-MM-DD"
      },
      "totalVisits": {
        "bsonType": "int",
        "minimum": 0,
        "description": "Total check-in transactions on this date"
      },
      "uniqueStudents": {
        "bsonType": "int",
        "minimum": 0,
        "description": "Distinct student count on this date"
      },
      "peakOccupancy": {
        "bsonType": "int",
        "minimum": 0,
        "description": "Highest simultaneous occupancy recorded"
      },
      "peakHour": {
        "bsonType": "string",
        "description": "Time interval with highest traffic (e.g. 18:00-19:00)"
      },
      "averageDurationMinutes": {
        "bsonType": ["int", "double"],
        "minimum": 0,
        "description": "Average workout duration in minutes"
      },
      "hourlyBreakdown": {
        "bsonType": "array",
        "description": "Hourly distribution for Admin Chart.js analytics",
        "items": {
          "bsonType": "object",
          "required": ["hour", "visits", "occupancy"],
          "properties": {
            "hour": {
              "bsonType": "string",
              "description": "Hour bucket (e.g. 06:00, 07:00, ... 21:00)"
            },
            "visits": {
              "bsonType": "int",
              "minimum": 0,
              "description": "Number of check-ins during this hour"
            },
            "occupancy": {
              "bsonType": "int",
              "minimum": 0,
              "description": "Average occupancy during this hour"
            }
          }
        }
      },
      "createdAt": {
        "bsonType": "date",
        "description": "Creation timestamp"
      },
      "updatedAt": {
        "bsonType": "date",
        "description": "Last update timestamp"
      }
    }
  }
}
