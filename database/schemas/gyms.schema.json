{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["gymId", "gymName", "location", "capacity", "currentOccupancy", "status", "nfcTagIdentifier"],
    "properties": {
      "gymId": {
        "bsonType": "string",
        "description": "Unique gym facility identifier (e.g. gym-001)"
      },
      "gymName": {
        "bsonType": "string",
        "description": "Full name of the facility"
      },
      "location": {
        "bsonType": "string",
        "description": "Building and floor location"
      },
      "capacity": {
        "bsonType": "int",
        "minimum": 1,
        "description": "Maximum allowed physical occupancy"
      },
      "currentOccupancy": {
        "bsonType": "int",
        "minimum": 0,
        "description": "Current number of students inside"
      },
      "status": {
        "enum": ["open", "closed", "maintenance"],
        "description": "Facility operational status"
      },
      "nfcTagIdentifier": {
        "bsonType": "string",
        "description": "Passive NFC payload string (e.g. SGC-GYM)"
      },
      "openingHours": {
        "bsonType": "object",
        "required": ["open", "close"],
        "properties": {
          "open": {
            "bsonType": "string",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Opening time in 24h format (HH:MM)"
          },
          "close": {
            "bsonType": "string",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Closing time in 24h format (HH:MM)"
          }
        }
      },
      "createdAt": {
        "bsonType": "date",
        "description": "Creation timestamp"
      },
      "updatedAt": {
        "bsonType": "date",
        "description": "Last update timestamp"
      }
    }
  }
}
