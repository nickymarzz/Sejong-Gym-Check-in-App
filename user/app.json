{
  "expo": {
    "name": "Sejong Gym Check-in",
    "slug": "sejong-gym-checkin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.ac.sejong.sgc",
      "infoPlist": {
        "NFCReaderUsageDescription": "Allows scanning SGC-GYM NFC stickers for gym check-in"
      }
    },
    "android": {
      "package": "kr.ac.sejong.sgc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#002667"
      },
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "react-native-nfc-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#002667",
          "largeIcon": "./assets/icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4be757d-d0bf-4fe5-b761-d4e0c43393e3"
      }
    },
    "owner": "se-project"
  }
}
